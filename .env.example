# Figma personal access token. Required from M1 onward.
# Never commit the real value; never log it; never persist it into IR/logs/benchmark artifacts (PRD §24).
FIGMA_TOKEN=

# PostgreSQL connection string. Only used from M9 onward, by ai-evaluation-cache and
# human-review-queue. The deterministic core (M0-M8) must never read this variable.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/figma_to_code

# AI provider keys. Only used from M9 onward (Phase 4 escalation). Never wired into
# any M0-M8 package.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
